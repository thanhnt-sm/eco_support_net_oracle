# DataGuard Environment Configuration
# Copy to `.env` and fill in values. Never commit real secrets.

# Database connection string (highest-priority credential source; overrides `.dataguard.yml`)
DATAGUARD_CONNECTION_STRING=

# Provider hint for auto-detection: sqlserver | oracle | mysql | postgresql
DATAGUARD_PROVIDER=

# (VS Code / Visual Studio extensions) path to the `dataguard` CLI executable
DATAGUARD_CLI_PATH=

# Vault token for the Zero-Trust credential provider (optional)
VAULT_TOKEN=
