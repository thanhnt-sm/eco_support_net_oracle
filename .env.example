# EcoSupport Environment Configuration

# Anthropic API Key (Required for Claude 3.7 Sonnet & Extended Thinking)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model Selection
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Extended Thinking Token Budget (Default: 4096 tokens, High: 16384 tokens)
THINKING_BUDGET_TOKENS=4096

# GitHub API Token (Optional, increases API rate limits for ecosystem radar)
GITHUB_TOKEN=your_github_personal_access_token_here

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# FastMCP Server Settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
