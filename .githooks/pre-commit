#!/usr/bin/env bash
# DataGuard pre-commit verification.

set -euo pipefail

if ! dotnet --version >/dev/null 2>&1; then
    if [[ -x "$HOME/.dotnet/dotnet" ]] && "$HOME/.dotnet/dotnet" --version >/dev/null 2>&1; then
        export PATH="$HOME/.dotnet:$PATH"
    elif [[ -x "$HOME/.dotnet/dotnet.exe" ]] && "$HOME/.dotnet/dotnet.exe" --version >/dev/null 2>&1; then
        export PATH="$HOME/.dotnet:$PATH"
    fi
fi
for py_dir in /c/Users/*/AppData/Local/Programs/Python/Python*; do
    if [[ -d "$py_dir" ]]; then
        export PATH="$PATH:$py_dir"
        break
    fi
done
if ! command -v dotnet >/dev/null 2>&1; then
    printf 'dotnet SDK is required for this DataGuard workspace.\n' >&2
    exit 1
fi

printf '[pre-commit] Verifying .NET whitespace formatting.\n'
dotnet format whitespace DataGuard.sln --verify-no-changes

printf '[pre-commit] Verifying staged path topology.\n'
./scripts/anti_garbage_guard.sh

printf '[pre-commit] Verifying documentation inventory.\n'
./scripts/verify_docs_sync.sh

printf '[pre-commit] Passed.\n'

