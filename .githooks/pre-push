#!/usr/bin/env bash
# DataGuard pre-push verification.

set -euo pipefail

if ! dotnet --version >/dev/null 2>&1; then
    if [[ -x "$HOME/.dotnet/dotnet" ]] && "$HOME/.dotnet/dotnet" --version >/dev/null 2>&1; then
        export PATH="$HOME/.dotnet:$PATH"
    elif [[ -x "$HOME/.dotnet/dotnet.exe" ]] && "$HOME/.dotnet/dotnet.exe" --version >/dev/null 2>&1; then
        export PATH="$HOME/.dotnet:$PATH"
    fi
fi
for py_dir in /c/Users/*/AppData/Local/Programs/Python/Python*; do
    if [[ -d "$py_dir" ]]; then
        export PATH="$PATH:$py_dir"
        break
    fi
done
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
printf '[pre-push] Running canonical blocking local gates.\n'
SKIP_ACT="${SKIP_ACT:-1}" ./scripts/verify_local_gates.sh
printf '[pre-push] Passed. Hosted GitHub matrix verification remains required after push.\n'
