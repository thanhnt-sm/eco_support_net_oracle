# ==============================================================================
# DATAGUARD ONE-CLICK RELEASE CONFIGURATION TEMPLATE
# ==============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Copy file này thành `.release.env`:
#      cp .release.env.example .release.env
# 2. Điền các giá trị bên dưới vào `.release.env`.
# 3. File `.release.env` đã được cấu hình trong `.gitignore`, TUYỆT ĐỐI KHÔNG
#    xóa khỏi .gitignore hoặc commit lên GitHub.
# 4. Chạy 1 lệnh duy nhất để release:
#      bash tools/git-tools/dg-release
#    (hoặc trên Windows Command Prompt: tools\git-tools\dg-release.cmd)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PHIÊN BẢN PHÁT HÀNH (RELEASE TAG) - BẮT BUỘC
# ------------------------------------------------------------------------------
# Định dạng chuẩn SemVer bắt đầu bằng chữ "v": vMAJOR.MINOR.PATCH
# Ví dụ: v1.0.0, v1.0.1, v1.1.0-rc.1
RELEASE_TAG=v1.0.0

# ------------------------------------------------------------------------------
# 2. PHÁT HÀNH EXTENSIONS LÊN MARKETPLACE (TUỲ CHỌN)
# ------------------------------------------------------------------------------
# - true:  Tự động kích hoạt publish cả VS Code Marketplace và Visual Studio Marketplace
#          sau khi Release workflow (NuGet + GitHub + GHCR) chạy thành công.
# - false: Chỉ phát hành NuGet packages, GitHub Release, SBOM, Attestation, GHCR Image.
PUBLISH_MARKETPLACES=true

# ------------------------------------------------------------------------------
# 3. GITHUB PERSONAL ACCESS TOKEN ĐỂ ĐIỀU PHỐI (BẮT BUỘC CHO REAL RELEASE)
# ------------------------------------------------------------------------------
# Token này dùng để theo dõi tiến độ workflow trên GitHub và gọi dispatch
# cho Marketplace workflow.
#
# Cách tạo token an toàn (Fine-Grained PAT với quyền tối thiểu):
#   1. Vào: https://github.com/settings/tokens?type=beta
#   2. Nhấn "Generate new token".
#   3. Token name: "DataGuard Release Dispatcher".
#   4. Repository access: Chọn "Only select repositories" -> chọn repo "eco_support_net_oracle".
#   5. Repository permissions:
#      - Actions: Read and write (để theo dõi và dispatch workflow)
#      - Contents: Read (để đọc thông tin repository)
#   6. Expiration: 30 ngày (hoặc ngắn hơn).
#   7. Dán token vào bên dưới (bắt đầu bằng github_pat_...):
DG_RELEASE_GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 4. CHẾ ĐỘ THỬ NGHIỆM / CHÍNH THỨC
# ------------------------------------------------------------------------------
# - DRY_RUN=true:  Chạy kiểm tra toàn bộ điều kiện (git status, remote branch,
#                  tag hợp lệ, token) nhưng KHÔNG tạo tag, KHÔNG push, KHÔNG publish.
#                  Khuyên dùng kiểm tra trước khi release thật.
# - DRY_RUN=false: Tiến hành phát hành thật sự lên các nền tảng.
DRY_RUN=false

# - CONFIRM_RELEASE=true: Đồng ý chạy phát hành mà không cần gõ thêm cờ --yes.
CONFIRM_RELEASE=true

# ------------------------------------------------------------------------------
# 5. THỜI GIAN CHỜ TỐI ĐA (TIMEOUT)
# ------------------------------------------------------------------------------
# Thời gian chờ (tính bằng giây) để tất cả các workflow GitHub Actions hoàn tất.
# Mặc định: 7200 giây (2 giờ).
TIMEOUT_SECONDS=7200

# ==============================================================================
# LƯU Ý AN TOÀN BẢO MẬT HỆ THỐNG:
# ------------------------------------------------------------------------------
# Các key xuất bản trực tiếp lên kho public (NuGet API Key, VSCE PAT,
# VS Marketplace PAT) KHÔNG ĐƯỢC để ở file này, mà cấu hình trực tiếp trong
# GitHub Actions Repository Secrets (Settings -> Secrets and variables -> Actions):
#
#   1. NUGET_USER hoặc NUGET_API_KEY : Token phát hành gói NuGet.org
#   2. VSCE_PAT                      : Personal Access Token phát hành VS Code Marketplace
#   3. VS_MARKETPLACE_PAT            : Personal Access Token phát hành Visual Studio Marketplace
#
# Bằng cách này, máy local không bao giờ nắm giữ trực tiếp các master key của kho ứng dụng.
# Nếu máy local bị xâm phạm, kẻ tấn công cũng không lấy được key phát hành ra công chúng.
# ==============================================================================
