<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>StackAccord</Product>
    <Title>StackAccord Analyzers</Title>
    <Authors>StackAccord Contributors</Authors>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageId>DataGuard.Analyzers</PackageId>
    <Description>Roslyn analyzers and quick fixes for StackAccord contract validation (IDE light layer).</Description>
    <PackageTags>efcore;stored-procedure;contract-validation;analyzers;roslyn</PackageTags>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- D4 (licence migration): build-time only. No lib/ assets, so the analyzer DLLs never flow into a
         consumer's bin/; they load from analyzers/dotnet/cs inside the compiler. Consumers that use the
         attributes ([SkipContractCheck], ...) install DataGuard.Contracts (MIT) for the compile
         reference; that package is also a normal nuspec dependency of this one (see the Contracts
         ProjectReference below), so it is restored transitively. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- NU5128: assemblies in generators/dotnet/cs are intentional (Roslyn analyzer
         packages host them outside lib); not a packaging defect. -->
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn 4.12 is the compiler line VS 2022 17.12+ and the .NET 9.0.1xx SDK run. Roslyn refuses an
         analyzer compiled against a newer Microsoft.CodeAnalysis (CS9057, no diagnostics at all), so this
         version is pinned: RoslynReferenceVersionTests, scripts/verify-analyzer-packaging.sh and the
         Dependabot ignore (.github/dependabot.yml) guard it. Microsoft.CodeAnalysis.Analyzers 3.11.0 is the
         matching line (no 4.12.0 of that package exists). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- One evaluator source, compiled against the IDE's pinned Roslyn. No Core runtime dependency. -->
    <Compile Include="../DataGuard.Core/Sources/CSharp/ConstantStringConcatResolver.cs" Link="Shared/ConstantStringConcatResolver.cs" />
    <ProjectReference Include="..\DataGuard.Contracts\DataGuard.Contracts.csproj" />
    <!-- SqlClassification is IsPackable=false and is embedded in analyzers/dotnet/cs via the None items
         below; PrivateAssets keeps it out of the nuspec so the package does not depend on an unpublished id. -->
    <ProjectReference Include="..\DataGuard.SqlClassification\DataGuard.SqlClassification.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compiler does not resolve NuGet dependencies of analyzer/generator
         assemblies; bundle DataGuard.Contracts (netstandard2.0) so attribute
         types resolve at load time. netstandard2.0 loads in both csc and VS. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DataGuard.Contracts.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DataGuard.Contracts.dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DataGuard.SqlClassification.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DataGuard.SqlClassification.dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
