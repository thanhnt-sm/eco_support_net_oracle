<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.Analyzers</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>DataGuard Contributors</Authors>
    <Description>Roslyn analyzers for DataGuard contract validation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compiler does not resolve NuGet dependencies of analyzer/generator assemblies,
         so bundle DataGuard.Core (and its non-framework, non-Roslyn dependencies) into the
         analyzer path. Without this the analyzer throws FileNotFoundException when loaded. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"
          Exclude="$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\Microsoft.CodeAnalysis*.dll" />
    <None Include="$(OutputPath)\*.dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false"
          Exclude="$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\Microsoft.CodeAnalysis*.dll" />
  </ItemGroup>
</Project>