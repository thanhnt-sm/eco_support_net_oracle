<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageId>DataGuard.Analyzers</PackageId>
    <Authors>DataGuard Contributors</Authors>
    <Description>Roslyn analyzers and quick fixes for DataGuard contract validation (IDE light layer).</Description>
    <PackageTags>efcore;stored-procedure;contract-validation;analyzers;roslyn</PackageTags>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <!-- Not a DevelopmentDependency: consumers need DataGuard.Contracts as a
         compile reference so quick-fix attributes ([SkipContractCheck], ...)
         actually compile. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- NU5128: assemblies in generators/dotnet/cs are intentional (Roslyn analyzer
         packages host them outside lib); not a packaging defect. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Contracts\DataGuard.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compiler does not resolve NuGet dependencies of analyzer/generator
         assemblies; bundle DataGuard.Contracts (netstandard2.0) so attribute
         types resolve at load time. netstandard2.0 loads in both csc and VS. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DataGuard.Contracts.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\DataGuard.Contracts.dll" Pack="true" PackagePath="generators/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
