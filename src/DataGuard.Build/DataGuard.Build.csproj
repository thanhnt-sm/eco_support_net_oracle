<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>DataGuard.Build</PackageId>
    <Description>Offline-only DataGuard MSBuild manifest validation task.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build/DataGuard.Build.targets" Pack="true" PackagePath="build/DataGuard.Build.targets" />
    <None Include="build/DataGuard.Build.targets" Pack="true" PackagePath="buildTransitive/DataGuard.Build.targets" />
  </ItemGroup>
</Project>
