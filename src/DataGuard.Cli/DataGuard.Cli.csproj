<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackageId>DataGuard.Cli</PackageId>
    <Description>DataGuard CLI tool for contract validation.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dataguard</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishBundledCli)' == 'true'">
    <AssemblyName>dataguard</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <ProjectReference Include="..\DataGuard.SqlServer.Adapter\DataGuard.SqlServer.Adapter.csproj" />
    <ProjectReference Include="..\DataGuard.Oracle.Adapter\DataGuard.Oracle.Adapter.csproj" />
    <ProjectReference Include="..\DataGuard.MySql.Adapter\DataGuard.MySql.Adapter.csproj" />
    <ProjectReference Include="..\DataGuard.PostgreSql.Adapter\DataGuard.PostgreSql.Adapter.csproj" />
    <ProjectReference Include="..\DataGuard.Analyzers\DataGuard.Analyzers.csproj" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.15" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests for the internal command services (config binding, snapshot checks). -->
    <InternalsVisibleTo Include="DataGuard.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licence and third-party notices travel with every channel that carries the CLI: publish output
         (RID archives, container image), the tool package root (Pack) and, via the publish copy, the
         tool payload. Oracle ODP.NET and Microsoft SNI require their licence text to accompany each
         copy. Sources live in docs/legal; Link flattens them next to the executable. -->
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE;$(MSBuildThisFileDirectory)../../docs/legal/THIRD-PARTY-NOTICES.md;$(MSBuildThisFileDirectory)../../docs/legal/ADDITIONAL-PERMISSIONS.md"
          CopyToPublishDirectory="PreserveNewest"
          Pack="true"
          PackagePath=""
          Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>