<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.MySql.Adapter</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>DataGuard Contributors</Authors>
    <Description>MySQL adapter for DataGuard contract validation. Requires MySqlConnector (MIT License).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DataGuard/DataGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DataGuard/DataGuard</RepositoryUrl>
    <PackageTags>efcore;stored-procedure;contract-validation;mysql</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
  </ItemGroup>
</Project>
