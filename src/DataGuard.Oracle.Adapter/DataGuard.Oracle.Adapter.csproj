<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>StackAccord</Product>
    <Title>StackAccord Oracle Adapter</Title>
    <Authors>StackAccord Contributors</Authors>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.Oracle.Adapter</PackageId>
    <Description>Oracle adapter for StackAccord contract validation. Requires Oracle.ManagedDataAccess.Core (Oracle Distribution License).</Description>
    <PackageTags>efcore;stored-procedure;contract-validation;oracle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
</Project>