<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.Oracle.Adapter</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>DataGuard Contributors</Authors>
    <Description>Oracle adapter for DataGuard contract validation. Requires Oracle.ManagedDataAccess.Core (Oracle Distribution License).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DataGuard/DataGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DataGuard/DataGuard</RepositoryUrl>
    <PackageTags>efcore;stored-procedure;contract-validation;oracle</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
  </ItemGroup>
</Project>