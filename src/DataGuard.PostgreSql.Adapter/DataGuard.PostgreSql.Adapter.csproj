<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>StackAccord</Product>
    <Title>StackAccord PostgreSql Adapter</Title>
    <Authors>StackAccord Contributors</Authors>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.PostgreSql.Adapter</PackageId>
    <Description>PostgreSQL adapter for StackAccord contract validation. Requires Npgsql (PostgreSQL License).</Description>
    <PackageTags>efcore;stored-procedure;contract-validation;postgresql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
