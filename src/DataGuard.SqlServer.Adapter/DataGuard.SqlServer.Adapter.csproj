<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.SqlServer.Adapter</PackageId>
    <Description>SQL Server adapter for DataGuard contract validation: catalog reader, live result-set describer, CLR type table and T-SQL (ScriptDOM) parsing. Requires Microsoft.Data.SqlClient (MIT License).</Description>
    <PackageProjectUrl>https://github.com/thanhnt-sm/eco_support_net_oracle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thanhnt-sm/eco_support_net_oracle</RepositoryUrl>
    <PackageTags>efcore;stored-procedure;contract-validation;sql-server</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />
  </ItemGroup>
</Project>