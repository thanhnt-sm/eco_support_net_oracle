<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>StackAccord</Product>
    <Title>StackAccord SqlServer Adapter</Title>
    <Authors>StackAccord Contributors</Authors>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>DataGuard.SqlServer.Adapter</PackageId>
    <Description>SQL Server adapter for StackAccord contract validation: catalog reader, live result-set describer, CLR type table and T-SQL (ScriptDOM) parsing. Requires Microsoft.Data.SqlClient (MIT License).</Description>
    <PackageProjectUrl>https://github.com/thanhnt-sm/eco_support_net_oracle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thanhnt-sm/eco_support_net_oracle</RepositoryUrl>
    <PackageTags>efcore;stored-procedure;contract-validation;sql-server</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
    <ProjectReference Include="..\DataGuard.Core\DataGuard.Core.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>