{
  "name": "dataguard-vscode",
  "displayName": "StackAccord",
  "description": "StackAccord detects database contract drift between .NET code, stored procedures, and SQL before it reaches production.",
  "version": "0.4.0",
  "publisher": "thanhnt-sm",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/thanhnt-sm/eco_support_net_oracle"
  },
  "homepage": "https://github.com/thanhnt-sm/eco_support_net_oracle#readme",
  "bugs": {
    "url": "https://github.com/thanhnt-sm/eco_support_net_oracle/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Linters",
    "Testing"
  ],
  "keywords": [
    "database",
    "sql",
    "stored-procedure",
    "dapper",
    "entity-framework",
    "schema-drift",
    "contract-testing",
    "sarif",
    "devsecops"
  ],
  "galleryBanner": {
    "color": "#0B2942",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "StackAccord runs a local validation CLI and only executes in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "StackAccord requires a local workspace and CLI executable."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:csharp",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dataguard.runValidation",
        "title": "StackAccord: Run Validation"
      },
      {
        "command": "dataguard.cancelValidation",
        "title": "StackAccord: Cancel Validation"
      },
      {
        "command": "dataguard.assess",
        "title": "StackAccord: Assess Workspace"
      },
      {
        "command": "dataguard.refreshSnapshot",
        "title": "StackAccord: Refresh Snapshot"
      },
      {
        "command": "dataguard.createBaseline",
        "title": "StackAccord: Create Baseline"
      },
      {
        "command": "dataguard.configureConnection",
        "title": "StackAccord: Configure Connection Credential"
      },
      {
        "command": "dataguard.openDashboard",
        "title": "StackAccord: Open Drift Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "dataguard.refreshFindings",
        "title": "StackAccord: Refresh Findings",
        "icon": "$(refresh)"
      },
      {
        "command": "dataguard.clearFindings",
        "title": "StackAccord: Clear Findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "dataguard.groupBySeverity",
        "title": "StackAccord: Group by Severity"
      },
      {
        "command": "dataguard.groupByRule",
        "title": "StackAccord: Group by Rule"
      },
      {
        "command": "dataguard.groupByFile",
        "title": "StackAccord: Group by File"
      },
      {
        "command": "dataguard.applyQuickFix",
        "title": "StackAccord: Apply Quick-Fix"
      },
      {
        "command": "dataguard.scanProject",
        "title": "StackAccord: Scan Project SQL & Mappings",
        "icon": "$(search)"
      },
      {
        "command": "dataguard.refreshQueries",
        "title": "StackAccord: Refresh SQL Queries",
        "icon": "$(refresh)"
      },
      {
        "command": "dataguard.verifyShape",
        "title": "StackAccord: Verify SQL Shapes Against Database",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataguard-explorer",
          "title": "StackAccord",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "dataguard-explorer": [
        {
          "id": "dataguard.findingsView",
          "name": "Contract Drift Findings"
        },
        {
          "id": "dataguard.sqlQueriesView",
          "name": "Discovered SQL Queries"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dataguard.openDashboard",
          "when": "view == dataguard.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "dataguard.refreshFindings",
          "when": "view == dataguard.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "dataguard.clearFindings",
          "when": "view == dataguard.findingsView",
          "group": "navigation@3"
        },
        {
          "command": "dataguard.refreshQueries",
          "when": "view == dataguard.sqlQueriesView",
          "group": "navigation@1"
        },
        {
          "command": "dataguard.scanProject",
          "when": "view == dataguard.sqlQueriesView",
          "group": "navigation@2"
        },
        {
          "command": "dataguard.verifyShape",
          "when": "view == dataguard.sqlQueriesView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dataguard.applyQuickFix",
          "when": "view == dataguard.findingsView && viewItem == findingWithQuickFix",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "StackAccord",
      "properties": {
        "dataguard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable StackAccord validation."
        },
        "dataguard.configPath": {
          "type": "string",
          "default": ".dataguard.yml",
          "scope": "resource",
          "description": "Path to the StackAccord configuration file, relative to the workspace root."
        },
        "dataguard.provider": {
          "type": "string",
          "enum": [
            "sqlserver",
            "postgresql",
            "mysql",
            "oracle"
          ],
          "default": "sqlserver",
          "scope": "resource",
          "description": "Database provider used by explicit StackAccord commands."
        },
        "dataguard.cliPath": {
          "type": "string",
          "default": "dataguard",
          "scope": "machine",
          "description": "Path or command name for the StackAccord CLI. Configure only in User Settings."
        },
        "dataguard.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 900,
          "scope": "window",
          "description": "Maximum validation duration before StackAccord terminates its process tree."
        },
        "dataguard.assessmentTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 900,
          "scope": "window",
          "description": "Maximum local assessment duration. Remote advisory lookup is never enabled by the extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && npm run test:typescript && node --test out/branding.test.js out/security.test.js out/run-coordinator.test.js out/command-args.test.js out/ide-safe-contract.test.js out/live-database-confirmation.test.js out/ui/design-tokens.test.js out/ui/dashboard-view.test.js out/ui/redaction.test.js out/ui/redaction-redteam.test.js out/ui/csp-security.test.js out/ui/sql-queries-tree.test.js out/ui/performance-smoke.test.js out/ui/codelens-provider.test.js out/ui/decoration-manager.test.js out/ui/hover-provider.test.js out/ui/providers-behavior.test.js out/extension-lifecycle.test.js out/ui/controllers-behavior.test.js out/edge-contracts.test.js",
    "test:coverage": "npm run compile && npm run test:typescript && node scripts/coverage.cjs",
    "test:typescript": "npx --no-install tsc --noEmit --ignoreConfig --strict --skipLibCheck --target ES2020 test/fixtures/generated-contract.ts",
    "test:extension-host": "npm run compile && node scripts/test-extension-host.cjs",
    "clean": "node -e \"const cp = require('child_process'); cp.spawnSync(process.platform === 'win32' ? '..\\..\\scripts\\clean-workspace.bat' : 'bash', process.platform === 'win32' ? ['--pre'] : ['../../scripts/clean-workspace.sh', '--pre'], { stdio: 'inherit' })\"",
    "prepare-lsp": "node scripts/package-lsp.cjs",
    "package": "npm run prepare-lsp && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "c8": "12.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "qs": "6.16.0"
  }
}
