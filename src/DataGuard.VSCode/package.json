{
  "name": "dataguard-vscode",
  "displayName": "DataGuard",
  "description": "Detect database contract drift between .NET code, stored procedures, and SQL before it reaches production.",
  "version": "0.2.3",
  "publisher": "thanhnt-sm",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/thanhnt-sm/eco_support_net_oracle"
  },
  "homepage": "https://github.com/thanhnt-sm/eco_support_net_oracle#readme",
  "bugs": {
    "url": "https://github.com/thanhnt-sm/eco_support_net_oracle/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing"
  ],
  "keywords": [
    "database",
    "sql",
    "stored-procedure",
    "dapper",
    "entity-framework",
    "schema-drift",
    "contract-testing",
    "sarif",
    "devsecops"
  ],
  "galleryBanner": {
    "color": "#0B2942",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DataGuard runs a local validation CLI and only executes in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "DataGuard requires a local workspace and CLI executable."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:csharp",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dataguard.runValidation",
        "title": "DataGuard: Run Validation"
      },
      {
        "command": "dataguard.cancelValidation",
        "title": "DataGuard: Cancel Validation"
      },
      {
        "command": "dataguard.assess",
        "title": "DataGuard: Assess Workspace"
      },
      {
        "command": "dataguard.refreshSnapshot",
        "title": "DataGuard: Refresh Snapshot"
      },
      {
        "command": "dataguard.createBaseline",
        "title": "DataGuard: Create Baseline"
      },
      {
        "command": "dataguard.configureConnection",
        "title": "DataGuard: Configure Connection Credential"
      },
      {
        "command": "dataguard.openDashboard",
        "title": "DataGuard: Open Drift Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "dataguard.refreshFindings",
        "title": "DataGuard: Refresh Findings",
        "icon": "$(refresh)"
      },
      {
        "command": "dataguard.clearFindings",
        "title": "DataGuard: Clear Findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "dataguard.groupBySeverity",
        "title": "DataGuard: Group by Severity"
      },
      {
        "command": "dataguard.groupByRule",
        "title": "DataGuard: Group by Rule"
      },
      {
        "command": "dataguard.groupByFile",
        "title": "DataGuard: Group by File"
      },
      {
        "command": "dataguard.applyQuickFix",
        "title": "DataGuard: Apply Quick-Fix"
      },
      {
        "command": "dataguard.scanProject",
        "title": "DataGuard: Scan Project SQL & Mappings",
        "icon": "$(search)"
      },
      {
        "command": "dataguard.refreshQueries",
        "title": "DataGuard: Refresh SQL Queries",
        "icon": "$(refresh)"
      },
      {
        "command": "dataguard.verifyShape",
        "title": "DataGuard: Verify SQL Shapes Against Database",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataguard-explorer",
          "title": "DataGuard",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "dataguard-explorer": [
        {
          "id": "dataguard.findingsView",
          "name": "Contract Drift Findings"
        },
        {
          "id": "dataguard.sqlQueriesView",
          "name": "Discovered SQL Queries"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dataguard.openDashboard",
          "when": "view == dataguard.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "dataguard.refreshFindings",
          "when": "view == dataguard.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "dataguard.clearFindings",
          "when": "view == dataguard.findingsView",
          "group": "navigation@3"
        },
        {
          "command": "dataguard.refreshQueries",
          "when": "view == dataguard.sqlQueriesView",
          "group": "navigation@1"
        },
        {
          "command": "dataguard.scanProject",
          "when": "view == dataguard.sqlQueriesView",
          "group": "navigation@2"
        },
        {
          "command": "dataguard.verifyShape",
          "when": "view == dataguard.sqlQueriesView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dataguard.applyQuickFix",
          "when": "view == dataguard.findingsView && viewItem == findingWithQuickFix",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "DataGuard",
      "properties": {
        "dataguard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DataGuard validation."
        },
        "dataguard.configPath": {
          "type": "string",
          "default": ".dataguard.yml",
          "scope": "resource",
          "description": "Path to the DataGuard configuration file, relative to the workspace root."
        },
        "dataguard.provider": {
          "type": "string",
          "enum": ["sqlserver", "postgresql", "mysql", "oracle"],
          "default": "sqlserver",
          "scope": "resource",
          "description": "Database provider used by explicit DataGuard commands."
        },
        "dataguard.cliPath": {
          "type": "string",
          "default": "dataguard",
          "scope": "machine",
          "description": "Path or command name for the DataGuard CLI. Configure only in User Settings."
        },
        "dataguard.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 900,
          "scope": "window",
          "description": "Maximum validation duration before DataGuard terminates its process tree."
        },
        "dataguard.assessmentTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 900,
          "scope": "window",
          "description": "Maximum local assessment duration. Remote advisory lookup is never enabled by the extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && npm run test:typescript && node --test out/security.test.js out/run-coordinator.test.js out/command-args.test.js out/ui/design-tokens.test.js out/ui/redaction.test.js out/ui/csp-security.test.js out/ui/sql-queries-tree.test.js out/ui/performance-smoke.test.js",
    "test:typescript": "npx --no-install tsc --noEmit --strict --skipLibCheck --target ES2020 test/fixtures/generated-contract.ts",
    "test:extension-host": "npm run compile && node scripts/test-extension-host.cjs",
    "prepare-lsp": "node scripts/package-lsp.cjs",
    "package": "npm run prepare-lsp && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "qs": "6.16.0"
  }
}
