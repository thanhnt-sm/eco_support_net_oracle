<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;SA1200;SA1600;SA1636</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataGuard.Analyzers\DataGuard.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\DataGuard.Contracts\DataGuard.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeInBuildOutput>false</IncludeInBuildOutput>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Microsoft.CodeAnalysis.Testing (rec 19): the .XUnit flavours are deprecated since 1.1.2,
         so the framework-neutral packages are used with DefaultVerifier. Workspaces is pinned to the
         repo Roslyn version so the testing packages' 1.0.1 floor never resolves an older compiler. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
    <!-- The Microsoft.CodeAnalysis.*.Testing 1.1.4 packages pull System.Private.Uri 4.3.0 transitively, which
         NuGet audit (CI Security Scan, NuGetAuditMode=all) flags as vulnerable (GHSA-5f2m-466j-3848,
         GHSA-x5qj-9vmx-7g6g, GHSA-xhfc-gr8f-ffwc). Pin the patched version until the testing packages move. -->
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
  </ItemGroup>
</Project>
