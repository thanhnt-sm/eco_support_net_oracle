<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireBaselineCoreAssembly" BeforeTargets="ResolveReferences" Condition="'$(BaselineCoreAssembly)' == ''">
    <Error Text="Set BaselineCoreAssembly to the retained baseline DataGuard.Core.dll when building this fixture." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.11" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.11" />
    <PackageReference Include="System.Reflection.Metadata" Version="10.0.11" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DataGuard.Core">
      <HintPath>$(BaselineCoreAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
