  "category": "MySql",
  "description": "VARCHAR(20000) with utf8mb4 needs 80000 bytes, over MySQL's 65535-byte limit",
  "provenance": {
    "source": "manual",
    "model": null,
    "date": "2026-10-05"
  },
  "input": {
    "entity": {
      "name": "Article",
