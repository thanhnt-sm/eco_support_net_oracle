      "properties": [
        {
          "name": "Id",
          "type": "int",
          "isPrimaryKey": true
        },
        {
          "name": "Body",
          "type": "string",
          "maxLength": 20000,
          "isNullable": false
        }
      ]
    },
    "provider": "MySql",
    "databaseSchema": {
      "tables": [
        {
          "name": "articles",
          "columns": [
            {
              "name": "id",
              "type": "INT",
              "nullable": false
            },
            {
              "name": "body",
              "type": "VARCHAR",
              "nullable": false,
              "char_length": 20000
            }
          ]
        }
      ]
    },
    "lengthSemantics": "CHAR"
  },
  "expectedDiagnostics": [
    {
      "ruleId": "MY003",
