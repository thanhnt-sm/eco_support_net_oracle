{
  "testCase": "SS_003",
  "category": "SqlServer",
  "description": "Oracle NVL used in a SQL Server query (should be ISNULL/COALESCE)",
  "provenance": {
    "source": "manual",
    "model": null,
    "date": "2026-10-05"
  },
  "input": {
    "sql": "SELECT o.Id, NVL(o.Status, 'new') AS Status FROM dbo.Orders o",
    "provider": "SqlServer",
    "databaseSchema": {
      "tables": [
        {
          "name": "dbo.Orders",
          "columns": [
            "Id",
            "CustomerId",
            "OrderDate",
            "Status"
          ]
        }
      ]
    }
  },
  "expectedDiagnostics": [
    {
      "ruleId": "DG010",
      "messageContains": "Keyword 'NVL' is unsupported",
      "severity": "Warning"
    }
  ]
