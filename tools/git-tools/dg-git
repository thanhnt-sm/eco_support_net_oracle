#!/usr/bin/env bash
# DataGuard Git Tools (dg-git) - Safe git operations for enterprise
# Works on Git Bash (Windows), macOS, Linux
# Usage: dg-git [command] [options]

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Defaults - FULL MODE by default
DG_GIT_DIR="${DG_GIT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
DG_CONFIG_FILE="${DG_GIT_DIR}/.dg-git.yml"
DG_FIX_MODE="${DG_FIX_MODE:-true}"
DG_YES_MODE="${DG_YES_MODE:-true}"
DG_STRICT_MODE="${DG_STRICT_MODE:-false}"
DG_DRY_RUN="${DG_DRY_RUN:-false}"

# Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
log_info() { echo -e "${BLUE}ℹ️  $*${NC}"; }
log_success() { echo -e "${GREEN}✅ $*${NC}"; }
log_warn() { echo -e "${YELLOW}⚠️  $*${NC}"; }
log_error() { echo -e "${RED}❌ $*${NC}"; }

# Find git root
find_git_root() {
    local dir="$(pwd)"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.git" ]]; then echo "$dir"; return 0; fi
        dir=$(dirname "$dir")
    done; return 1
}

require_git_repo() {
    if ! DG_GIT_DIR=$(git rev-parse --show-toplevel 2>/dev/null); then
        echo -e "${RED}❌ Not a git repository${NC}" >&2; exit 1
    fi
    export DG_GIT_DIR
}

load_config() {
    if [[ -f "$DG_GIT_DIR/.dg-git.yml" ]]; then
        while IFS='=' read -r key value; do
            [[ $key =~ ^[[:space:]]*# ]] && continue
            [[ -z $key ]] && continue
            key=$(echo "$key" | xargs); value=$(echo "$value" | xargs)
            export "DG_${key^^}"="$value"
        done < "$DG_GIT_DIR/.dg-git.yml"
    fi
}

# ==================== COMMANDS ====================

cmd_doctor() {
    require_git_repo; load_config
    cd "$DG_GIT_DIR"
    log_info "🔍 Checking repository health..."
    
    local issues=0 warnings=0 fixed=0
    
    # 1. Detached HEAD
    if git status | grep -q "HEAD detached"; then
        echo -e "${RED}❌ Detached HEAD${NC}"; ((issues++))
    fi
    
    # 2. Merge conflicts
    if git status | grep -qE "both modified|both added|both deleted"; then
        echo -e "${RED}❌ Merge conflicts${NC}"; ((issues++))
    fi
    
    # 3. Large files staged (>100MB)
    while IFS= read -r file; do
        [[ -f "$file" ]] && {
            size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
            [[ $size -gt 104857600 ]] && { log_error "Large file: $file ($(numfmt --to=iec $size 2>/dev/null || echo $size))"; ((issues++)); }
        }
    done < <(git diff --cached --name-only)
    
    # 4. Sensitive files staged
    local sensitive_patterns=('\.env$' '\.env\.' '\.pem$' '\.key$' '\.p12$' '\.pfx$' 'id_rsa$' 'id_ed25519$' '\.p8$' '\.ppk$' 'appsettings\.json$' 'appsettings\..*\.json$' '\.pem$' '\.crt$' '\.cer$' '\.p12$' '\.pfx$')
    while IFS= read -r file; do
        for p in "${sensitive_patterns[@]}"; do [[ "$file" =~ $p ]] && { log_warn "Sensitive file: $file"; ((warnings++)); }; done
    done < <(git diff --cached --name-only)
    
    # 5. Secrets in staged (git-secrets if available)
    command -v git-secrets >/dev/null && ! git secrets --scan --cached 2>/dev/null && { log_error "Secrets in staged files"; ((issues++)); }
    
    # 6. Large files in history
    local large_files=$(git rev-list --objects --all | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | awk '$1=="blob" && $3>104857600 {print $4}' | head -5)
    [[ -n "$large_files" ]] && { log_warn "Large files in history:"; echo "$large_files" | while read f; do log_warn "  $f"; done; ((warnings++)); }
    
    # 7. Branch tracking & divergence
    local branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    [[ "$branch" != "HEAD" ]] && {
        local upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
        [[ -z "$upstream" ]] && { log_warn "Branch '$branch' not tracking remote"; ((warnings++)); }
        local ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
        local behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
        [[ $ahead -gt 0 && $behind -gt 0 ]] && { log_error "Diverged ($ahead ahead, $behind behind)"; ((issues++)); }
        [[ $behind -gt 0 ]] && { log_warn "$behind commits behind"; ((warnings++)); }
    }
    
    # 8. Remotes
    git remote | grep -q '^origin$' || log_warn "No 'origin' remote"
    
    # Summary
    echo
    if [[ $issues -gt 0 ]]; then log_error "Issues: $issues, Warnings: $warnings"; return 1
    elif [[ $warnings -gt 0 ]]; then log_warn "Warnings: $warnings"; return 0
    else log_success "Healthy"; return 0; fi
}

cmd_commit() {
    require_git_repo
    local msg="" no_verify=false files=()
    while [[ $# -gt 0 ]]; do case $1 in -m) shift; msg="$1";; --no-verify) no_verify=true;; --file) files+=("$2"); shift;; *) break;; esac; shift; done
    [[ -z "$msg" ]] && { echo "Usage: dg-git commit -m \"msg\" [--file file...]"; exit 1; }
    [[ "$no_verify" != true ]] && cmd_doctor || { echo "Use --no-verify to skip"; exit 1; }
    preflight_stage || exit 0
    [[ ${#files[@]} -gt 0 ]] && git add "${files[@]}" || git add -A
    git commit -m "$msg"
    log_success "Committed: $(git rev-parse --short HEAD) - $msg"
}

# List what would be staged; refuse silently staging everything unless yes_mode.
preflight_stage() {
    local files=()
    while IFS= read -r f; do files+=("$f"); done < <(git status --porcelain)
    if [[ ${#files[@]} -eq 0 ]]; then log_info "Working tree clean - nothing to commit"; return 1; fi
    log_info "Files to stage (${#files[@]}):"
    printf '  %s\n' "${files[@]}"
    if [[ "${DG_YES_MODE:-true}" != "true" ]]; then
        read -p "Stage and commit all? (y/N) " -n 1 -r; echo
        [[ $REPLY =~ ^[Yy]$ ]] || { log_warn "Aborted"; return 1; }
    fi
    return 0
}

cmd_push() {
    require_git_repo
    local remote="origin" set_upstream=false dry_run=false
    while [[ $# -gt 0 ]]; do case $1 in --remote) remote="$2"; shift;; --set-upstream) set_upstream=true;; --dry-run) dry_run=true;; *) break;; esac; shift; done
    local branch=$(git rev-parse --abbrev-ref HEAD)
    local behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
    local ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
    [[ $behind -gt 0 && $ahead -gt 0 ]] && { log_error "Diverged ($ahead ahead, $behind behind)"; log_info "Run 'dg-git sync'"; exit 1; }
    [[ $behind -gt 0 ]] && log_warn "$behind behind"
    [[ "$dry_run" == true ]] && { log_info "Dry run: would push to $remote"; exit 0; }
    git push "$remote" HEAD${set_upstream:+ -u $remote}
    log_success "Pushed to $remote"
}

cmd_sync() {
    require_git_repo
    local msg="" fix_mode=true yes_mode=true
    while [[ $# -gt 0 ]]; do case $1 in -m) shift; msg="$1";; --no-fix) fix_mode=false;; --no-yes) DG_YES_MODE=false;; *) break;; esac; shift; done
    # No message: auto-generate a conventional commit message so a bare
    # `dg-git` runs the full workflow end-to-end.
    [[ -z "$msg" ]] && msg="chore: auto-sync $(date +%Y-%m-%d-%H%M%S)"
    cmd_doctor
    preflight_stage || return 0
    git add -A
    cmd_secret || return 0   # abort if git-secrets flags staged content
    git commit -m "$msg"; git push
    log_success "Synced: $msg"
}

cmd_branch() {
    require_git_repo
    local action="" name=""
    while [[ $# -gt 0 ]]; do case $1 in --create) action=create; name="$2"; shift;; --rename) action=rename; name="$2"; shift;; --delete) action=delete; name="$2"; shift;; --list) action=list;; *) break;; esac; shift; done
    case "$action" in
        create) git checkout -b "$name"; log_success "Created: $name";;
        rename) git branch -m "$name"; log_success "Renamed to $name";;
        delete) read -p "Delete '$name'? (y/N) " -n 1 -r; echo; [[ $REPLY =~ ^[Yy]$ ]] && git branch -d "$name" && log_success "Deleted: $name";;
        list) git branch -a;;
        *) echo "Usage: dg-git branch [--create|--rename|--delete|--list] <name>";; esac
}

cmd_secret() {
    if command -v git-secrets >/dev/null; then
        git secrets --scan --cached
        return $?
    fi
    log_warn "git-secrets not installed, scanning basic patterns..."
    local found=0
    while read -r f; do
        [[ -f "$f" ]] && grep -qE "(api[_-]?key|secret|password|token|secret)" "$f" 2>/dev/null && { log_warn "Potential secret: $f"; found=1; }
    done < <(git diff --cached --name-only)
    return $found
}

cmd_config() {
    local action="" key="" value=""
    while [[ $# -gt 0 ]]; do case $1 in --show) action=show;; --set) action=set; key="$2"; value="$3"; shift 2;; --get) action=get; key="$2"; shift;; --reset) action=reset;; *) break;; esac; shift; done
    local cfg="$DG_GIT_DIR/.dg-git.yml"
    case "$action" in show) [[ -f "$DG_GIT_DIR/.dg-git.yml" ]] && cat "$DG_GIT_DIR/.dg-git.yml" || log_info "No config";; set) mkdir -p "$(dirname "$DG_GIT_DIR/.dg-git.yml")"; echo "$key: $value" >> "$DG_GIT_DIR/.dg-git.yml"; log_success "Set $key=$value";; get) grep "^$key:" "$DG_GIT_DIR/.dg-git.yml" 2>/dev/null | cut -d' ' -f2- || true;; reset) rm -f "$DG_GIT_DIR/.dg-git.yml"; log_success "Config reset";; *) echo "Usage: dg-git config [--show|--set key val|--get key|--reset]";; esac
}

# Main
main() {
    load_config() { [[ -f "$DG_GIT_DIR/.dg-git.yml" ]] && while IFS='=' read -r k v; do [[ $k =~ ^[[:space:]]*# ]] && continue; [[ -z $k ]] && continue; k=$(echo "$k"|xargs); v=$(echo "$v"|xargs); export "DG_${k^^}"="$v"; done < "$DG_GIT_DIR/.dg-git.yml"; :; }
    load_config
    
    cmd="${1:-sync}"; shift || true
    case "$cmd" in
        doctor) cmd_doctor "$@" ;;
        commit) cmd_commit "$@" ;;
        push) cmd_push "$@" ;;
        sync) cmd_sync "$@" ;;
        branch) cmd_branch "$@" ;;
        secret) cmd_secret "$@" ;;
        config) cmd_config "$@" ;;
        help|--help|-h)
            cat <<'EOF'
DataGuard Git Tools (dg-git) - Safe git operations

Usage: dg-git [command] [options]
  (no command = full workflow: doctor → commit (auto message) → push)

Commands:
  doctor      Check repo health (default: fix=yes, yes=yes, strict=no)
  commit      Safe commit with validation
  push        Safe push (no force, auto upstream)
  sync        Doctor → secret scan → commit → push (default: fix=yes, yes=yes)
  branch      Branch management
  secret      Scan for secrets
  config      Manage config

Environment Variables (or .dg-git.yml):
  DG_FIX_MODE=true       Auto-fix safe issues (default: true)
  DG_YES_MODE=true       Skip confirmations (default: true)
  DG_STRICT_MODE=false   Strict mode (default: false)
  DG_DRY_RUN=false       Dry run mode (default: false)

Config file: .dg-git.yml
  fix_mode: true
  yes_mode: true
  strict_mode: false
  dry_run: false

Examples:
  dg-git                    # Full workflow (doctor → commit → push, auto message)
  dg-git doctor             # Full check with auto-fix
  dg-git commit -m "feat"   # Safe commit
  dg-git push               # Safe push
  dg-git sync -m "feat"     # Full workflow with explicit message
  dg-git branch --create feat/new
  dg-git secret             # Scan secrets
  dg-git config --show

EOF
            exit 0;;
        *) log_error "Unknown: $cmd"; exit 1;; esac
}

# Helpers
log_info() { echo -e "\033[0;34mℹ️  $*\033[0m"; }
log_success() { echo -e "\033[0;32m✅ $*\033[0m"; }
log_warn() { echo -e "\033[1;33m⚠️  $*\033[0m"; }
log_error() { echo -e "\033[0;31m❌ $*\033[0m" >&2; }
require_git_repo() { DG_GIT_DIR=$(git rev-parse --show-toplevel 2>/dev/null) || { log_error "Not a git repo"; exit 1; }; export DG_GIT_DIR; }
load_config() { [[ -f "$DG_GIT_DIR/.dg-git.yml" ]] && while IFS='=' read -r k v; do [[ $k =~ ^[[:space:]]*# ]] && continue; [[ -z $k ]] && continue; k=$(echo "$k"|xargs); v=$(echo "$v"|xargs); export "DG_${k^^}"="$v"; done < "$DG_GIT_DIR/.dg-git.yml"; :; }
log_info() { echo -e "\033[0;34mℹ️  $*\033[0m"; }
log_success() { echo -e "\033[0;32m✅ $*\033[0m"; }
log_warn() { echo -e "\033[1;33m⚠️  $*\033[0m"; }
log_error() { echo -e "\033[0;31m❌ $*\033[0m" >&2; }

main "$@"