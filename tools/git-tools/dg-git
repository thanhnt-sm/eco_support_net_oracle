#!/usr/bin/env bash
# DataGuard Git Tools (dg-git) - Safe git operations for enterprise
# Works on Git Bash (Windows), macOS, Linux
# Usage: dg-git [command] [options]

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Defaults - FULL MODE by default
DG_GIT_DIR="${DG_GIT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
DG_CONFIG_FILE="${DG_GIT_DIR}/.dg-git.yml"
DG_FIX_MODE="${DG_FIX_MODE:-true}"
DG_YES_MODE="${DG_YES_MODE:-true}"
DG_STRICT_MODE="${DG_STRICT_MODE:-false}"
# Support a per-user SDK installed by dotnet-install so direct `bash dg-git`
# works as reliably as the Windows dg-git.cmd wrapper.
if [[ -x "$HOME/.dotnet/dotnet" || -x "$HOME/.dotnet/dotnet.exe" ]]; then
    export PATH="$HOME/.dotnet:$PATH"
fi
# `act` is a portable GitHub Actions runner. Docker Desktop remains the only
# container runtime; neither tool is installed project-wide.
if [[ -x "$HOME/.act/bin/act" || -x "$HOME/.act/bin/act.exe" ]]; then
    export PATH="$HOME/.act/bin:$PATH"
fi
if [[ -d "/c/Program Files/Docker/Docker/resources/bin" ]]; then
    export PATH="/c/Program Files/Docker/Docker/resources/bin:$PATH"
fi


DG_DRY_RUN="${DG_DRY_RUN:-false}"

# Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
log_info() { echo -e "${BLUE}ℹ️  $*${NC}"; }
log_success() { echo -e "${GREEN}✅ $*${NC}"; }
log_warn() { echo -e "${YELLOW}⚠️  $*${NC}"; }
log_error() { echo -e "${RED}❌ $*${NC}"; }

# Find git root
find_git_root() {
    local dir="$(pwd)"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.git" ]]; then echo "$dir"; return 0; fi
        dir=$(dirname "$dir")
    done; return 1
}

require_git_repo() {
    if ! DG_GIT_DIR=$(git rev-parse --show-toplevel 2>/dev/null); then
        echo -e "${RED}❌ Not a git repository${NC}" >&2; exit 1
    fi
    export DG_GIT_DIR
}

load_config() {
    if [[ -f "$DG_GIT_DIR/.dg-git.yml" ]]; then
        while IFS='=' read -r key value; do
            [[ $key =~ ^[[:space:]]*# ]] && continue
            [[ -z $key ]] && continue
            key=$(echo "$key" | xargs); value=$(echo "$value" | xargs)
            export "DG_${key^^}"="$value"
        done < "$DG_GIT_DIR/.dg-git.yml"
    fi
}

# ==================== COMMANDS ====================

cmd_doctor() {
    require_git_repo; load_config
    cd "$DG_GIT_DIR"
    log_info "🔍 Checking repository health..."
    
    local issues=0 warnings=0 fixed=0
    
    # 1. Detached HEAD
    if git status | grep -q "HEAD detached"; then
        echo -e "${RED}❌ Detached HEAD${NC}"; ((issues++))
    fi
    
    # 2. Merge conflicts
    if git status | grep -qE "both modified|both added|both deleted"; then
        echo -e "${RED}❌ Merge conflicts${NC}"; ((issues++))
    fi
    
    # 3. Large files staged (>100MB)
    while IFS= read -r file; do
        [[ -f "$file" ]] && {
            size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
            [[ $size -gt 104857600 ]] && { log_error "Large file: $file ($(numfmt --to=iec $size 2>/dev/null || echo $size))"; ((issues++)); }
        }
    done < <(git diff --cached --name-only)
    
    # 4. Sensitive files staged
    local sensitive_patterns=('\.env$' '\.env\.' '\.pem$' '\.key$' '\.p12$' '\.pfx$' 'id_rsa$' 'id_ed25519$' '\.p8$' '\.ppk$' 'appsettings\.json$' 'appsettings\..*\.json$' '\.pem$' '\.crt$' '\.cer$' '\.p12$' '\.pfx$')
    while IFS= read -r file; do
        for p in "${sensitive_patterns[@]}"; do [[ "$file" =~ $p ]] && { log_warn "Sensitive file: $file"; ((warnings++)); }; done
    done < <(git diff --cached --name-only)
    
    # 5. Secrets in staged (git-secrets if available)
    command -v git-secrets >/dev/null && ! git secrets --scan --cached 2>/dev/null && { log_error "Secrets in staged files"; ((issues++)); }
    
    # 6. Large files in history
    local large_files=$(git rev-list --objects --all | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | awk '$1=="blob" && $3>104857600 {print $4}' | head -5)
    [[ -n "$large_files" ]] && { log_warn "Large files in history:"; echo "$large_files" | while read f; do log_warn "  $f"; done; ((warnings++)); }
    
    # 7. Branch tracking & divergence
    local branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    [[ "$branch" != "HEAD" ]] && {
        local upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
        [[ -z "$upstream" ]] && { log_warn "Branch '$branch' not tracking remote"; ((warnings++)); }
        local ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
        local behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
        [[ $ahead -gt 0 && $behind -gt 0 ]] && { log_error "Diverged ($ahead ahead, $behind behind)"; ((issues++)); }
        [[ $behind -gt 0 ]] && { log_warn "$behind commits behind"; ((warnings++)); }
        [[ $ahead -gt 0 ]] && { log_warn "$ahead commits ahead (unpushed)"; ((warnings++)); }
    }
    
    # 8. Remotes
    git remote | grep -q '^origin$' || log_warn "No 'origin' remote"
    
    # Summary
    echo
    if [[ $issues -gt 0 ]]; then log_error "Issues: $issues, Warnings: $warnings"; return 1
    elif [[ $warnings -gt 0 ]]; then log_warn "Warnings: $warnings"; return 0
    else log_success "Healthy"; return 0; fi
}

cmd_commit() {
    require_git_repo
    local msg="" no_verify=false files=()
    while [[ $# -gt 0 ]]; do case $1 in -m) shift; msg="$1";; --no-verify) no_verify=true;; --file) files+=("$2"); shift;; *) break;; esac; shift; done
    [[ -z "$msg" ]] && { echo "Usage: dg-git commit -m \"msg\" [--file file...]"; exit 1; }
    reject_auto_msg "$msg" || exit 1
    [[ "$no_verify" != true ]] && cmd_doctor || { echo "Use --no-verify to skip"; exit 1; }
    preflight_stage || exit 0
    [[ ${#files[@]} -gt 0 ]] && git add "${files[@]}" || git add -A
    git commit -m "$msg"
    log_success "Committed: $(git rev-parse --short HEAD) - $msg"
}

# List what would be staged; refuse silently staging everything unless yes_mode.
preflight_stage() {
    local files=()
    while IFS= read -r f; do files+=("$f"); done < <(git status --porcelain)
    if [[ ${#files[@]} -eq 0 ]]; then log_info "Working tree clean - nothing to commit"; return 1; fi
    log_info "Files to stage (${#files[@]}):"
    printf '  %s\n' "${files[@]}"
    if [[ "${DG_YES_MODE:-true}" != "true" ]]; then
        read -p "Stage and commit all? (y/N) " -n 1 -r; echo
        [[ $REPLY =~ ^[Yy]$ ]] || { log_warn "Aborted"; return 1; }
    fi
    return 0
}

cmd_pull() {
    require_git_repo
    local status
    status=$(git status --porcelain)
    if [[ -n "$status" ]]; then
        log_error "Working tree has uncommitted changes. Please commit, stash, or discard changes before pulling."
        return 1
    fi
    git pull --ff-only
    log_success "Pulled and fast-forwarded from configured upstream"
}

cmd_push() {
    require_git_repo
    local remote="origin" set_upstream="" dry_run=false
    while [[ $# -gt 0 ]]; do case $1 in --remote) remote="$2"; shift;; --set-upstream) set_upstream=true;; --dry-run) dry_run=true;; *) break;; esac; shift; done
    local branch=$(git rev-parse --abbrev-ref HEAD)
    local behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
    local ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
    [[ $behind -gt 0 && $ahead -gt 0 ]] && { log_error "Diverged ($ahead ahead, $behind behind)"; log_info "Run 'dg-git sync'"; exit 1; }
    [[ $behind -gt 0 ]] && log_warn "$behind behind"
    [[ "$dry_run" == true ]] && { log_info "Dry run: would push to $remote"; exit 0; }
    git push "$remote" "$branch"${set_upstream:+ -u "$remote"}
    log_success "Pushed to $remote"
}

auto_heal_workspace() {
    local lockfile="$DG_GIT_DIR/.git/index.lock"
    if [[ -f "$lockfile" ]]; then
        log_error "Git đang bị khóa bởi '$lockfile'."
        log_info "Đóng mọi Git/VS Code đang chạy. Nếu chắc chắn không còn Git chạy, xóa file này rồi chạy lại dg-git."
        return 1
    fi

    git config core.safecrlf false 2>/dev/null || true
    [[ -d "$DG_GIT_DIR/.githooks" ]] && git config core.hooksPath .githooks 2>/dev/null || true
    return 0
}

show_conflict_guide() {
    local conflict_files=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && conflict_files+=("$f")
    done < <(git diff --name-only --diff-filter=U 2>/dev/null || true)

    echo ""
    echo -e "${RED}╔════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║ ❌ PHÁT HIỆN XUNG ĐỘT CODE (MERGE/REBASE CONFLICT) VỚI GITHUB!         ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════════════════════╝${NC}"
    if [[ ${#conflict_files[@]} -gt 0 ]]; then
        echo -e "${YELLOW}Các file sau đang có xung đột giữa code của bạn và code GitHub:${NC}"
        for f in "${conflict_files[@]}"; do
            echo -e "   ${RED}• $f${NC}"
        done
    fi
    echo ""
    echo -e "${CYAN}👉 HƯỚNG DẪN XỬ LÝ ĐƠN GIẢN (chọn 1 trong 3 cách):${NC}"
    echo -e "   ${GREEN}Cách 1 (Giữ code của BẠN trên máy local):${NC}"
    echo -e "      git checkout --ours <tên_file> && git add <tên_file>"
    echo -e "   ${GREEN}Cách 2 (Lấy đè code mới nhất từ GITHUB về bỏ code local):${NC}"
    echo -e "      git checkout --theirs <tên_file> && git add <tên_file>"
    echo -e "   ${GREEN}Cách 3 (Sửa trực tiếp):${NC}"
    echo -e "      Mở file trên trong VS Code, chọn 'Accept Current' hoặc 'Accept Incoming',"
    echo -e "      sau đó gõ: git add <tên_file>"
    echo -e "${CYAN}Sau khi chọn và stage từng file, hoàn tất thao tác Git đang dở:${NC}"
    echo -e "  ${GREEN}• Rebase:${NC} git rebase --continue"
    echo -e "  ${GREEN}• Merge:${NC}  git commit"
    echo -e "Sau đó chạy lại: ${GREEN}dg-git${NC}"
    echo ""
}
run_local_github_workflows() {
    local runner_image="catthehacker/ubuntu:act-latest"
    if [[ "${DG_SKIP_LOCAL_ACTIONS:-false}" == "true" ]]; then
        log_info "Bỏ qua GitHub Actions local theo DG_SKIP_LOCAL_ACTIONS=true."
        return 0
    fi


    if ! command -v act >/dev/null 2>&1; then
        log_error "Không tìm thấy act. Cài portable runner tại %USERPROFILE%\\.act\\bin rồi chạy lại."
        return 1
    fi
    if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
        log_error "Docker Desktop chưa sẵn sàng. Khởi động Docker Desktop rồi chạy lại dg-git."
        return 1
    fi

    log_info "🧪 Chạy job Build and Test của CI local bằng act + Docker trước khi commit..."
    log_info "Runner image: $runner_image (lần đầu Docker sẽ tải image này)."
    # `act`'s medium image cannot faithfully run CI's SBOM (.NET 8 runtime),
    # TruffleHog's nested Docker scan, or CodeQL. Those gates remain enforced
    # by GitHub Actions after the push.
    act push \
        --workflows "$DG_GIT_DIR/.github/workflows/ci.yml" \
        --job build-and-test \
        --env ACT=true \
        --platform "ubuntu-latest=$runner_image" || {
        log_error "CI Build and Test local thất bại; hủy commit/push."
        return 1
    }

    act push \
        --workflows "$DG_GIT_DIR/.github/workflows/standards-audit.yml" \
        --platform "ubuntu-latest=$runner_image" || {
        log_error "Standards audit local thất bại; hủy commit/push."
        return 1
    }
    # Release and marketplace workflows can publish packages, releases, or
    # marketplace extensions. They must stay GitHub-hosted and are never run
    # automatically from a developer workstation.
    log_info "Đã chạy Build and Test cùng standards audit local. SBOM, TruffleHog, CodeQL, release, marketplace, và Scorecard chạy trên GitHub sau push."
}


cmd_sync() {
    require_git_repo
    auto_heal_workspace || return 1
    local msg="" fix_mode=true yes_mode=true
    while [[ $# -gt 0 ]]; do
        case $1 in
            -m) shift; msg="$1";;
            --no-fix) fix_mode=false;;
            --no-yes) DG_YES_MODE=false;;
            *) break;;
        esac
        shift
    done

    echo -e "${CYAN}=======================================================${NC}"
    echo -e "${CYAN}🚀 [DataGuard Git] BẮT ĐẦU QUY TRÌNH ĐỒNG BỘ TOÀN DIỆN...${NC}"
    echo -e "${CYAN}=======================================================${NC}"

    # 1. Health check
    log_info "🔍 [1/7] Kiểm tra sức khỏe repository..."
    cmd_doctor || {
        log_error "Kiểm tra repo phát hiện vấn đề cần xử lý trước. Xem thông báo phía trên."
        return 1
    }

    # 2. Detect remote & branches
    local remote="origin"
    if ! git remote | grep -q "^origin$"; then
        remote=$(git remote | head -n 1 || true)
    fi
    if [[ -z "$remote" ]]; then
        log_error "Chưa cấu hình remote GitHub nào trong repository!"
        log_info "Để liên kết kho GitHub, hãy chạy: git remote add origin <link_repo>"
        return 1
    fi
    # Download remote state before making any local integration decision.
    log_info "📥 [2/7] Luôn tải code mới nhất từ GitHub về máy trước (Fetch All)..."
    git fetch --all --prune --tags || {
        log_error "Không thể kết nối hoặc tải code từ GitHub (kiểm tra lại internet hoặc quyền truy cập)."
        return 1
    }
    log_success "Đã nạp toàn bộ dữ liệu mới nhất từ GitHub."

    local default_branch
    default_branch=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)
    default_branch="${default_branch#"$remote/"}"
    if [[ -z "$default_branch" ]]; then
        default_branch="main"
        git show-ref --verify --quiet "refs/remotes/$remote/master" &&
            ! git show-ref --verify --quiet "refs/remotes/$remote/main" &&
            default_branch="master"
    fi

    local orig_branch
    orig_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$orig_branch" == "HEAD" ]]; then
        log_error "Detached HEAD detected. Switch to a named branch before syncing."
        return 1
    fi

    local conflict_files
    conflict_files=$(git diff --name-only --diff-filter=U 2>/dev/null || true)
    if [[ -n "$conflict_files" ]]; then
        show_conflict_guide
        return 1
    fi

    # 4. BẢO VỆ CODE ĐANG SỬA DỞ CỦA NGƯỜI DÙNG (AUTO-STASH)
    local autostashed=false
    local changes
    changes=$(git status --porcelain)
    if [[ -n "$changes" ]]; then
        log_info "📦 [3/7] Phát hiện thay đổi dở dang trên máy, quét bảo mật & cất tạm an toàn..."
        if ! cmd_secret; then
            log_error "Phát hiện nguy cơ rò rỉ secret/token/password trong code chưa commit!"
            log_error "Dừng đồng bộ ngay lập tức để bảo vệ tài khoản GitHub của bạn."
            return 1
        fi

        # Stash untracked and tracked uncommitted changes safely
        git stash push --include-untracked -m "dg-git-autostash-$(date +%s)" >/dev/null 2>&1
        autostashed=true
        log_success "Đã bảo vệ code dở dang vào bộ nhớ tạm. Working tree hiện đã sạch."
    else
        log_info "✨ [3/7] Thư mục làm việc sạch sẽ, sẵn sàng đồng bộ."
    fi



    # 5. ĐỒNG BỘ NHÁNH CHÍNH (MAIN) TỪ GITHUB VÀ XỬ LÝ CONFLICT
    log_info "🔄 [4/7] Đồng bộ nhánh chính '$default_branch' với '$remote/$default_branch'..."
    if ! git show-ref --verify --quiet "refs/remotes/$remote/$default_branch"; then
        log_error "Remote '$remote' không có nhánh '$default_branch'. Kiểm tra lại cấu hình GitHub."
        return 1
    fi
    if ! git show-ref --verify --quiet "refs/heads/$default_branch"; then
        git branch --track "$default_branch" "$remote/$default_branch"
    fi
    if [[ "$(git rev-parse --abbrev-ref HEAD)" != "$default_branch" ]]; then
        git checkout "$default_branch"
    fi

    local behind ahead
    behind=$(git rev-list --count "$default_branch..$remote/$default_branch" 2>/dev/null || echo 0)
    ahead=$(git rev-list --count "$remote/$default_branch..$default_branch" 2>/dev/null || echo 0)

    if [[ $behind -gt 0 && $ahead -eq 0 ]]; then
        log_info "⬇️  Nhánh '$default_branch' đang sau GitHub $behind commit. Đang kéo về (Fast-forward)..."
        git merge --ff-only "$remote/$default_branch" || {
            log_error "Fast-forward thất bại."
            return 1
        }
        log_success "Nhánh '$default_branch' đã bắt kịp code mới nhất trên GitHub."
    elif [[ $behind -gt 0 && $ahead -gt 0 ]]; then
        log_warn "Nhánh '$default_branch' vừa có commit local ($ahead) vừa có commit GitHub ($behind). Đang hòa nhập (Rebase)..."
        if ! git rebase "$remote/$default_branch"; then
            show_conflict_guide
            return 1
        fi
        log_success "Đã rebase thành công commit local lên trên code mới nhất từ GitHub."
    elif [[ $behind -eq 0 && $ahead -gt 0 ]]; then
        log_info "Nhánh '$default_branch' đang có $ahead commit mới sẵn sàng đẩy lên."
    else
        log_info "Nhánh '$default_branch' đã khớp hoàn toàn với GitHub."
    fi

    # 6. XỬ LÝ CÁC NHÁNH CODE LOCAL, GỘP (MERGE) VÀO NHÁNH CHÍNH
    log_info "🌿 [5/7] Kiểm tra và gộp tất cả các nhánh local vào nhánh chính '$default_branch'..."
    local local_branches=()
    while IFS= read -r b; do
        b=$(echo "$b" | xargs)
        [[ -z "$b" || "$b" == "$default_branch" || "$b" == "* $default_branch" ]] && continue
        b="${b#\* }"
        local_branches+=("$b")
    done < <(git branch --list --format='%(refname:short)')

    for b in "${local_branches[@]}"; do
        local unmerged
        unmerged=$(git rev-list --count "$default_branch..$b" 2>/dev/null || echo 0)
        if [[ $unmerged -gt 0 ]]; then
            log_info "🔀 Nhánh phụ '$b' có $unmerged commit mới. Đang gộp vào '$default_branch'..."
            if ! git merge --no-ff "$b" -m "merge(branch): gộp nhánh $b vào $default_branch"; then
                show_conflict_guide
                return 1
            fi
            log_success "Đã gộp thành công nhánh '$b' vào '$default_branch'."
        fi
    done

    # If user was on a feature branch, rebase it on main so feature branch is also up to date
    if [[ "$orig_branch" != "$default_branch" ]]; then
        git checkout "$orig_branch"
        log_info "Cập nhật nhánh hiện tại '$orig_branch' với code mới nhất của '$default_branch'..."
        if ! git rebase "$default_branch"; then
            show_conflict_guide
            return 1
        fi
        git checkout "$default_branch"
    fi

    # 7. KHÔI PHỤC LẠI CODE ĐANG LÀM DỞ CỦA NGƯỜI DÙNG
    if [[ "$autostashed" == true ]]; then
        log_info "📦 [6/7] Khôi phục lại các file đang làm dở lên nền code mới nhất..."
        if ! git stash pop >/dev/null 2>&1; then
            show_conflict_guide
            return 1
        fi
        log_success "Code đang làm dở đã được khôi phục nguyên vẹn trên nền code mới nhất từ GitHub."
    fi

    # 8. TỰ ĐỘNG COMMIT CÁC FILE THAY ĐỔI
    local final_changes
    final_changes=$(git status --porcelain)
    if [[ -n "$final_changes" ]]; then
        log_info "💾 Đang tự động lưu (commit) các thay đổi..."
        if ! cmd_secret; then
            log_error "Phát hiện nguy cơ lộ secret trong các file vừa khôi phục. Hủy commit để an toàn."
            return 1
        fi
        if [[ -f "$DG_GIT_DIR/DataGuard.sln" ]] && command -v dotnet >/dev/null 2>&1; then
            log_info "🧹 Đang áp dụng định dạng .NET bắt buộc trước khi commit..."
            dotnet format whitespace DataGuard.sln || {
                log_error "Không thể tự sửa định dạng .NET. Xem lỗi phía trên."
                return 1
            }
        fi
        run_local_github_workflows || return 1



        if [[ -z "$msg" ]]; then
            local file_count
            file_count=$(echo "$final_changes" | wc -l | tr -d ' ')
            msg="chore(workspace): synchronize local changes ($file_count files) $(date +'%Y-%m-%d %H:%M:%S')"
        else
            reject_auto_msg "$msg" || return 1
        fi

        git add -A
        git commit -m "$msg"
        log_success "Đã commit: $(git rev-parse --short HEAD) - $msg"
    fi

    # 9. PUSH TOÀN BỘ LÊN GITHUB
    local unpushed
    unpushed=$(git rev-list --count "$remote/$default_branch..$default_branch" 2>/dev/null || echo 0)
    if [[ $unpushed -gt 0 ]]; then
        log_info "🚀 [7/7] Đẩy $unpushed commit mới lên GitHub..."
        git push -u "$remote" "$default_branch" || {
            log_error "Lỗi khi đẩy code lên GitHub. Kiểm tra lại quyền đẩy (write permission) hoặc mạng."
            return 1
        }
        log_success "Đã đẩy nhánh '$default_branch' lên GitHub an toàn."
    else
        log_info "🚀 [7/7] Không có commit mới để push; bỏ qua pre-push check tốn thời gian."
    fi

    # Also push any other local branches that have tracking or need pushing
    for b in "${local_branches[@]}"; do
        if git show-ref --verify --quiet "refs/remotes/$remote/$b"; then
            local b_ahead
            b_ahead=$(git rev-list --count "$remote/$b..$b" 2>/dev/null || echo 0)
            if [[ $b_ahead -gt 0 ]]; then
                git push "$remote" "$b" 2>/dev/null || true
            fi
        fi
    done

    echo ""
    echo -e "${GREEN}=======================================================${NC}"
    echo -e "${GREEN}✅ HOÀN TẤT ĐỒNG BỘ TOÀN DIỆN VỚI GITHUB THÀNH CÔNG!    ${NC}"
    echo -e "${GREEN}=======================================================${NC}"
    echo -e "  ${CYAN}• Đã lấy code mới nhất từ GitHub về máy local.${NC}"
    echo -e "  ${CYAN}• Đã gộp và tích hợp các nhánh local vào '$default_branch'.${NC}"
    echo -e "  ${CYAN}• Đã lưu và commit toàn bộ thay đổi an toàn.${NC}"
    echo -e "  ${CYAN}• Đã đẩy toàn bộ code lên GitHub ($remote/$default_branch).${NC}"
    echo -e "  ${CYAN}• Commit hiện tại: $(git rev-parse --short HEAD)${NC}"
    echo ""
}

cmd_branch() {
    require_git_repo
    local action="" name=""
    while [[ $# -gt 0 ]]; do case $1 in --create) action=create; name="$2"; shift;; --rename) action=rename; name="$2"; shift;; --delete) action=delete; name="$2"; shift;; --list) action=list;; *) break;; esac; shift; done
    case "$action" in
        create) git checkout -b "$name"; log_success "Created: $name";;
        rename) git branch -m "$name"; log_success "Renamed to $name";;
        delete) read -p "Delete '$name'? (y/N) " -n 1 -r; echo; [[ $REPLY =~ ^[Yy]$ ]] && git branch -d "$name" && log_success "Deleted: $name";;
        list) git branch -a;;
        *) echo "Usage: dg-git branch [--create|--rename|--delete|--list] <name>";; esac
}

cmd_secret() {
    local scan_files=()
    # Paths from git status cover staged, unstaged and untracked files.
    while IFS= read -r line; do
        local path="${line:3}"
        [[ -n "$path" ]] && scan_files+=("$path")
    done < <(git status --porcelain)
    if command -v git-secrets >/dev/null; then
        if [[ ${#scan_files[@]} -gt 0 ]]; then
            git secrets --scan "${scan_files[@]}"
            return $?
        fi
        return 0
    fi
    log_warn "git-secrets not installed, scanning for high-signal secret VALUES..."
    # Only flag actual secret-shaped values, not prose mentioning the words
    # "secret"/"token"/"password" (policy docs and rule files are full of those).
    local patterns=(
        'ghp_[A-Za-z0-9]{20,}'
        'github_pat_[A-Za-z0-9_]{20,}'
        'AKIA[0-9A-Z]{16}'
        'sk-[A-Za-z0-9]{20,}'
        'xox[baprs]-[A-Za-z0-9-]{10,}'
        'AIza[0-9A-Za-z_-]{35}'
        '-----BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY-----'
        'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
        '(api[_-]?key|secret|password|passwd|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}["'"'"']'
        '(api[_-]?key|secret|password|passwd|token)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9+/]{16,}'
    )
    local joined=$(IFS='|'; echo "${patterns[*]}")
    local found=0
    for f in "${scan_files[@]}"; do
        [[ -f "$f" ]] && grep -Eq "$joined" "$f" 2>/dev/null && { log_warn "Potential secret: $f"; found=1; }
    done
    return $found
}

cmd_config() {
    local action="" key="" value=""
    while [[ $# -gt 0 ]]; do case $1 in --show) action=show;; --set) action=set; key="$2"; value="$3"; shift 2;; --get) action=get; key="$2"; shift;; --reset) action=reset;; *) break;; esac; shift; done
    local cfg="$DG_GIT_DIR/.dg-git.yml"
    case "$action" in show) [[ -f "$DG_GIT_DIR/.dg-git.yml" ]] && cat "$DG_GIT_DIR/.dg-git.yml" || log_info "No config";; set) mkdir -p "$(dirname "$DG_GIT_DIR/.dg-git.yml")"; echo "$key: $value" >> "$DG_GIT_DIR/.dg-git.yml"; log_success "Set $key=$value";; get) grep "^$key:" "$DG_GIT_DIR/.dg-git.yml" 2>/dev/null | cut -d' ' -f2- || true;; reset) rm -f "$DG_GIT_DIR/.dg-git.yml"; log_success "Config reset";; *) echo "Usage: dg-git config [--show|--set key val|--get key|--reset]";; esac
}

# Reject generic auto-sync / timestamp-junk commit messages.
reject_auto_msg() {
    local m="$1"
    if printf '%s' "$m" | grep -Eq '^[[:space:]]*chore:[[:space:]]*auto[-_ ]?sync'; then
        log_error "Refusing generic auto-sync commit message: '$m'"
        log_error "Provide a meaningful Conventional Commit (feat/fix/chore/docs/refactor/test/ci/build/perf)."
        return 1
    fi
    return 0
}

# Main
main() {
    load_config() { [[ -f "$DG_GIT_DIR/.dg-git.yml" ]] && while IFS='=' read -r k v; do [[ $k =~ ^[[:space:]]*# ]] && continue; [[ -z $k ]] && continue; k=$(echo "$k"|xargs); v=$(echo "$v"|xargs); export "DG_${k^^}"="$v"; done < "$DG_GIT_DIR/.dg-git.yml"; :; }
    load_config
    
    cmd="${1:-sync}"
    if [[ $# -gt 0 ]]; then
        shift
    fi
    case "$cmd" in
        doctor) cmd_doctor "$@" ;;
        commit) cmd_commit "$@" ;;
        pull) cmd_pull "$@" ;;
        push) cmd_push "$@" ;;
        sync) cmd_sync "$@" ;;
        branch) cmd_branch "$@" ;;
        secret) cmd_secret "$@" ;;
        config) cmd_config "$@" ;;
        release) exec "$(dirname "${BASH_SOURCE[0]}")/dg-release" "$@" ;;
        help|--help|-h)
            cat <<'EOF'
DataGuard Git Tools (dg-git) - Safe git operations

Usage: dg-git [command] [options]
  (default: no command = full automated sync: doctor → secret scan → commit → pull/rebase → push)

Commands:
  sync        Full sync: check → commit → pull/rebase → push (default)
  pull        Fetch and fast-forward the configured upstream
  push        Safe push (no force, auto upstream)
  commit      Safe commit with validation
  doctor      Check repo health (default: fix=yes, yes=yes, strict=no)
  branch      Branch management
  secret      Scan for secrets
  config      Manage config
  release     One-click multi-platform release (NuGet, GitHub, GHCR, Marketplaces)
Environment Variables (or .dg-git.yml):
  DG_FIX_MODE=true       Auto-fix safe issues (default: true)
  DG_YES_MODE=true       Skip confirmations (default: true)
  DG_STRICT_MODE=false   Strict mode (default: false)
  DG_DRY_RUN=false       Dry run mode (default: false)

Config file: .dg-git.yml
  fix_mode: true
  yes_mode: true
  strict_mode: false
  dry_run: false

Examples:
  dg-git                    # Full automated sync (check → commit → pull/rebase → push)
  dg-git pull               # Fetch and fast-forward the configured upstream
  dg-git sync -m "feat"     # Full sync with custom commit message
  dg-git doctor             # Read-only repo health check
  dg-git commit -m "feat"   # Safe commit
  dg-git push               # Safe push
  dg-git branch --create feat/new
  dg-git secret             # Scan secrets
  dg-git config --show
EOF
            exit 0;;
        *) log_error "Unknown: $cmd"; exit 1;; esac
}

# Helpers
log_info() { echo -e "\033[0;34mℹ️  $*\033[0m"; }
log_success() { echo -e "\033[0;32m✅ $*\033[0m"; }
log_warn() { echo -e "\033[1;33m⚠️  $*\033[0m"; }
log_error() { echo -e "\033[0;31m❌ $*\033[0m" >&2; }
require_git_repo() { DG_GIT_DIR=$(git rev-parse --show-toplevel 2>/dev/null) || { log_error "Not a git repo"; exit 1; }; export DG_GIT_DIR; }
load_config() { [[ -f "$DG_GIT_DIR/.dg-git.yml" ]] && while IFS='=' read -r k v; do [[ $k =~ ^[[:space:]]*# ]] && continue; [[ -z $k ]] && continue; k=$(echo "$k"|xargs); v=$(echo "$v"|xargs); export "DG_${k^^}"="$v"; done < "$DG_GIT_DIR/.dg-git.yml"; :; }
log_info() { echo -e "\033[0;34mℹ️  $*\033[0m"; }
log_success() { echo -e "\033[0;32m✅ $*\033[0m"; }
log_warn() { echo -e "\033[1;33m⚠️  $*\033[0m"; }
log_error() { echo -e "\033[0;31m❌ $*\033[0m" >&2; }

main "$@"